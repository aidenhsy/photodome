  "info": {
    "title": "PhotoDome API",
    "description": "Backend API for the PhotoDome iPhone app.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "eventCapability": {
        "scheme": "bearer",
        "bearerFormat": "event capability",
        "type": "http",
        "description": "Opaque event-scoped host or guest capability."
      }
    },
    "schemas": {
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "displayName": {
            "type": "string",
            "example": "James",
            "minLength": 1,
            "maxLength": 50
          },
          "locationLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "name",
          "displayName"
        ]
      },
      "EventViewerDto": {
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "HOST",
              "GUEST"
            ]
          }
        },
        "required": [
          "memberId",
          "role"
        ]
      },
      "EventSnapshotDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "James's birthday"
          },
          "hostDisplayName": {
            "type": "string",
            "example": "James"
          },
          "locationLabel": {
            "type": "string",
            "nullable": true,
            "example": "Shibuya"
          },
          "state": {
            "type": "string",
            "enum": [
              "LIVE",
              "ENDED",
              "EXPIRING"
            ]
          },
          "memberCount": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "example": 2
          },
          "readyPhotoCount": {
            "type": "number",
            "minimum": 0,
            "example": 24
          },
          "createdAt": {
            "type": "string",
            "example": "2026-07-25T00:00:00.000Z"
          },
          "endedAt": {
            "type": "string",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "nullable": true
          },
          "uploadsRestrictedAt": {
            "type": "string",
            "nullable": true
          },
          "viewer": {
            "$ref": "#/components/schemas/EventViewerDto"
          }
        },
        "required": [
          "id",
          "name",
          "hostDisplayName",
          "state",
          "memberCount",
          "readyPhotoCount",
          "createdAt",
          "viewer"
        ]
      },
      "HostEventAccessDto": {
        "type": "object",
        "properties": {
          "event": {
            "$ref": "#/components/schemas/EventSnapshotDto"
          },
          "capability": {
            "type": "string",
            "example": "pdc_OpaqueEventCapabilityReturnedOnce",
            "writeOnly": true
          },
          "joinCode": {
            "type": "string",
            "example": "7JMPK4QX"
          }
        },
        "required": [
          "event",
          "capability",
          "joinCode"
        ]
      },
      "JoinEventDto": {
