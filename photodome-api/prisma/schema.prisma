generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventState {
  LIVE
  ENDED
  EXPIRING
}

enum EventMemberRole {
  HOST
  GUEST
}

enum PhotoState {
  RESERVED
  PROCESSING
  READY
  FAILED
  REMOVED
  EXPIRED
}

enum PhotoSelectionDecision {
  KEEP
  SKIP
}

model Event {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String              @db.VarChar(120)
  hostDisplayName     String              @map("host_display_name") @db.VarChar(50)
  coverPhotoId        String?             @map("cover_photo_id") @db.Uuid
  locationLabel       String?             @map("location_label") @db.VarChar(160)
  state               EventState          @default(LIVE)
  joinCodeHash        String              @unique @map("join_code_hash") @db.Char(64)
  uploadsRestrictedAt DateTime?           @map("uploads_restricted_at") @db.Timestamptz(3)
  endedAt             DateTime?           @map("ended_at") @db.Timestamptz(3)
  expiresAt           DateTime?           @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  members             EventMember[]
  hostTransferTokens  HostTransferToken[]
  photos              Photo[]
  photoDeletionTombstones PhotoDeletionTombstone[]
  photoSelections     PhotoSelection[]

  @@map("events")
}

model EventCleanupTombstone {
  eventId       String    @id @map("event_id") @db.Uuid
  prefix        String    @unique @db.VarChar(300)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("event_cleanup_tombstones")
}

model EventMember {
  id                String          @id @default(uuid()) @db.Uuid
  eventId           String          @map("event_id") @db.Uuid
  role              EventMemberRole
  displayName       String          @map("display_name") @db.VarChar(50)
  capabilityHash    String          @unique @map("capability_hash") @db.Char(64)
  removedAt         DateTime?       @map("removed_at") @db.Timestamptz(3)
  joinedAt          DateTime        @default(now()) @map("joined_at") @db.Timestamptz(3)
  liveActivityToken String?         @map("live_activity_token") @db.VarChar(512)
  event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photos            Photo[]
  photoSelections   PhotoSelection[]

  @@index([eventId, removedAt])
  @@index([eventId, role])
  @@index([eventId, liveActivityToken])
  @@map("event_members")
}

model Photo {
  id                        String      @id @default(uuid()) @db.Uuid
  eventId                   String      @map("event_id") @db.Uuid
  contributorMemberId       String      @map("contributor_member_id") @db.Uuid
  state                     PhotoState  @default(RESERVED)
  originalKey               String      @unique @map("original_key") @db.VarChar(300)
  displayKey                String      @unique @map("display_key") @db.VarChar(300)
  thumbKey                  String      @unique @map("thumb_key") @db.VarChar(300)
  contentType               String      @map("content_type") @db.VarChar(80)
  byteSize                  Int         @map("byte_size")
  sha256                    String      @db.Char(64)
  width                     Int
  height                    Int
  capturedAt                DateTime?   @map("captured_at") @db.Timestamptz(3)
  orientation               Int         @default(1)
  admittedBeforeRestriction Boolean     @map("admitted_before_restriction")
  reservedAt                DateTime    @default(now()) @map("reserved_at") @db.Timestamptz(3)
  uploadedAt                DateTime?   @map("uploaded_at") @db.Timestamptz(3)
  readyAt                   DateTime?   @map("ready_at") @db.Timestamptz(3)
  removedAt                 DateTime?   @map("removed_at") @db.Timestamptz(3)
  failureReason             String?     @map("failure_reason") @db.VarChar(160)
  event                     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contributor               EventMember @relation(fields: [contributorMemberId], references: [id], onDelete: Cascade)
  deletionTombstone         PhotoDeletionTombstone?
  selections                PhotoSelection[]

  @@index([eventId, state, readyAt])
  @@index([contributorMemberId, state])
  @@map("photos")
}

model PhotoSelection {
  id        String                 @id @default(uuid()) @db.Uuid
  eventId   String                 @map("event_id") @db.Uuid
  memberId  String                 @map("member_id") @db.Uuid
  photoId   String                 @map("photo_id") @db.Uuid
  decision  PhotoSelectionDecision
  decidedAt DateTime               @map("decided_at") @db.Timestamptz(3)
  event     Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member    EventMember            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  photo     Photo                  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([memberId, photoId])
  @@index([eventId, memberId, decidedAt])
  @@index([memberId, decision])
  @@map("photo_selections")
}

model PhotoDeletionTombstone {
  id            String   @id @default(uuid()) @db.Uuid
  photoId       String   @unique @map("photo_id") @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  originalKey   String   @map("original_key") @db.VarChar(300)
  displayKey    String   @map("display_key") @db.VarChar(300)
  thumbKey      String   @map("thumb_key") @db.VarChar(300)
  attemptCount  Int      @default(0) @map("attempt_count")
  lastError     String?  @map("last_error") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  photo         Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("photo_deletion_tombstones")
}

model HostTransferToken {
  id         String    @id @default(uuid()) @db.Uuid
  eventId    String    @map("event_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, consumedAt])
  @@map("host_transfer_tokens")
}
