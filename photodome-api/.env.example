NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://photodome:photodome@localhost:5434/photodome?schema=public
REDIS_URL=redis://localhost:6381
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=
CAPABILITY_PEPPER=local-development-capability-pepper-change-me
HOST_TRANSFER_TTL_SECONDS=600
GCS_PROJECT_ID=photodome-local
MEDIA_BUCKET_NAME=photodome-media-dev
GCS_API_ENDPOINT=http://127.0.0.1:4443
SIGNED_URL_TTL_SECONDS=300
CLEANUP_RECONCILIATION_INTERVAL_SECONDS=300
# Optional private Prometheus scrape endpoint: GET /v1/internal/metrics
# Required when NODE_ENV=production.
# METRICS_BEARER_TOKEN=
# ActivityKit remote updates are disabled until all four credentials are set.
# NODE_ENV=production also requires APNS_ENVIRONMENT=production and all four
# values below.
APNS_ENVIRONMENT=sandbox
# APNS_BUNDLE_ID=com.younger7jp.photodome
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
