{
  "name": "photodome-api",
  "version": "0.1.0",
  "description": "PhotoDome NestJS API",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,scripts,test}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "openapi:export": "ts-node scripts/export-openapi.ts ../photodome-ios/openapi.json",
    "gcs:verify": "DISABLE_BACKGROUND_WORKERS=1 ts-node scripts/verify-gcs.ts",
    "scale:verify": "npm run test:e2e:prepare && ts-node scripts/verify-scale.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "prisma migrate deploy && node dist/src/main.js",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e:prepare": "ts-node scripts/prepare-test-database.ts",
    "test:e2e": "npm run test:e2e:prepare && DISABLE_BACKGROUND_WORKERS=1 jest --config test/jest-e2e.json --runInBand --detectOpenHandles test/app.e2e-spec.ts && DISABLE_BACKGROUND_WORKERS=1 jest --config test/jest-e2e.json --runInBand --detectOpenHandles test/events.e2e-spec.ts && jest --config test/jest-e2e.json --runInBand test/media.e2e-spec.ts && DISABLE_BACKGROUND_WORKERS=1 jest --config test/jest-e2e.json --runInBand --detectOpenHandles test/curation.e2e-spec.ts && jest --config test/jest-e2e.json --runInBand test/expiry.e2e-spec.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "7.21.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.28",
    "@prisma/client": "6.19.3",
    "bullmq": "5.78.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prisma": "6.19.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.16.0",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.0.0",
    "jest": "30.2.0",
    "pg": "8.16.3",
    "prettier": "3.7.4",
    "socket.io-client": "4.8.3",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/jest.setup.ts"
    ]
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
